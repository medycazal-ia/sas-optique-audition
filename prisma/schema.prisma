// Schéma de données transverse (Lot 0) + module Dossier client (Lot 1) +
// module Produits & catalogue (Lot 2, optique V1).
// Source : docs/dossier-cadrage.md > "Modèle de données" et modules
// "Dossier client" / "Produits & catalogue".
//
// Principe directeur du dossier de cadrage : un dossier client unique relie
// tout (santé, commerce, mutuelle, commande, livraison, finance, service).
// Les entités des modules non encore réalisés (Proposition, Commande, Facture,
// SAV, ...) ne sont donc PAS créées ici tant que leur lot n'est pas lancé —
// seules les entités des lots déjà réalisés le sont, pour ne pas figer un
// schéma sur des modules non spécifiés en détail.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Fondations transverses (Lot 0) ----------------------------------------

/// Compte collaborateur (comptoir, back-office). Authentification par
/// email + mot de passe (hash bcrypt) — pas de gestion de compte client ici,
/// uniquement le personnel du magasin. Le profil complet (nom, prénom,
/// contact perso, pseudo) est géré depuis la carte Utilisateurs (rôle
/// DIRECTEUR et au-dessus) — nullable pour les comptes créés avant son
/// existence, obligatoire pour toute création via cette carte.
model Utilisateur {
  id             String          @id @default(cuid())
  creeA          DateTime        @default(now())
  email          String          @unique
  nom            String
  prenom         String?
  telephonePerso String?
  pseudo         String?         @unique
  motDePasseHash String
  role           RoleUtilisateur @default(COLLABORATEUR)
  actif          Boolean         @default(true)

  // Bannissement : "pour faute", distinct d'une simple désactivation
  // temporaire (actif=false). Bloque la connexion comme actif=false, mais
  // trace explicitement le motif — jamais une simple case décochée sans
  // justification. Réversible par un DIRECTEUR (ou plus), l'historique du
  // bannissement reste néanmoins visible.
  banni      Boolean   @default(false)
  banniA     DateTime?
  banniMotif String?
  banniPar   String? // email de l'auteur du bannissement/débannissement

  derniereConnexionA DateTime?

  // Magasin (point de vente) de rattachement — géré depuis le Super Admin
  // (voir model Magasin). Nullable : un compte peut n'être rattaché à
  // aucun magasin en particulier (ex. avant affectation, ou un directeur
  // qui supervise plusieurs points de vente).
  magasinId String?
  magasin   Magasin? @relation(fields: [magasinId], references: [id])

  @@index([role])
  @@index([magasinId])
}

/// DIRECTEUR : accès à toutes les fonctions courantes de gestion (y compris
/// la carte Utilisateurs), sans restriction. SUPER_ADMIN est un niveau
/// au-dessus, réservé au fondateur et à qui il désigne : jamais attribuable
/// depuis l'interface (aucune route API ne permet de définir ce rôle), donc
/// jamais visible ni modifiable par un DIRECTEUR — seulement à la main, en
/// accès direct à la base (ex. console SQL Render), en complément de la
/// reconnaissance par email via la variable d'environnement
/// SUPER_ADMIN_EMAILS (voir src/lib/session-edge.ts) : les deux mécanismes
/// sont indépendants et redondants l'un de l'autre, à dessein. D'autres
/// rôles à accès restreint (ex. CONSEILLER) viendront s'ajouter plus tard,
/// une fois leurs restrictions précisées.
enum RoleUtilisateur {
  COLLABORATEUR
  DIRECTEUR
  SUPER_ADMIN
}

/// Journal d'audit : "chaque écriture significative génère un Événement
/// journalisé — jamais de modification silencieuse" (modèle de données).
model Evenement {
  id         String    @id @default(cuid())
  survenuA   DateTime  @default(now())
  type       String // ex: "personne.creee", "consentement.modifie", "document.ajoute"
  entite     String // ex: "Personne"
  entiteId   String // id de l'enregistrement concerné
  acteur     String? // qui a fait l'action (utilisateur/collaborateur) — nullable en attendant l'auth
  canal      String    @default("comptoir") // comptoir | web | voix | automatisation
  donnees    Json? // détail de la modification (avant/après), jamais de données de santé en clair si évitable
  personneId String?
  personne   Personne? @relation(fields: [personneId], references: [id])

  @@index([entite, entiteId])
  @@index([personneId])
  @@index([survenuA])
}

// --- Module Dossier client (Lot 1) ------------------------------------------

/// Regroupement de personnes — cas des mutuelles familiales (assuré + ayants droit).
model Foyer {
  id        String     @id @default(cuid())
  creeA     DateTime   @default(now())
  nom       String? // nom d'usage du foyer, optionnel (ex. "Foyer Dupont")
  personnes Personne[]
}

/// Entité centrale du dossier : identité, coordonnées, préférences de contact,
/// consentements. "Aucun dossier n'a de statut de flux — c'est le socle
/// permanent" (dossier-cadrage.md, Module Dossier client).
model Personne {
  id       String   @id @default(cuid())
  creeA    DateTime @default(now())
  modifieA DateTime @updatedAt

  // État civil
  civilite              String? // M. | Mme | autre — jamais obligatoire
  prenom                String
  nom                   String
  dateNaissance         DateTime?
  numeroSecuriteSociale String? // NIR — optionnel (vente comptoir possible sans), sert aussi à la recherche

  // Marque un dossier créé par (ou pour) un compte démo — jamais posé par un
  // utilisateur normal. Seul cas où l'application supprime réellement des
  // données (voir réinitialisation démo), plutôt que de les archiver : ce
  // n'est jamais une vraie donnée client.
  estDemo Boolean @default(false)

  // Coordonnées
  telephone  String?
  email      String?
  adresse    String?
  codePostal String?
  ville      String?

  // Rattachement foyer / rôle assuré
  foyerId    String?
  foyer      Foyer?     @relation(fields: [foyerId], references: [id])
  roleAssure RoleAssure @default(NON_RENSEIGNE)

  // Préférences de contact
  contactPrefereSms   Boolean @default(false)
  contactPrefereEmail Boolean @default(false)

  // Consentements RGPD — "stockés avec horodatage et modifiables à tout
  // moment par le client" (critère d'acceptation V1 du module). Un
  // consentement distinct par canal de contact (l'email et le SMS/téléphone
  // ne sont pas la même sollicitation) — voir docs/dossier-cadrage.md.
  consentementEmail      Boolean   @default(false)
  consentementEmailA     DateTime?
  consentementSms        Boolean   @default(false)
  consentementSmsA       DateTime?
  consentementTelephone  Boolean   @default(false)
  consentementTelephoneA DateTime?

  // Horodatage du moment où le client a été informé des traitements RGPD
  // (données de santé traitées au titre du soin, canaux de contact
  // commerciaux distincts) et a validé ses choix — sur cet écran ou via le
  // document papier signé puis scanné (voir TypeDocument.CONSENTEMENT_RGPD).
  // Tant qu'il est nul, la pop-up RGPD se réaffiche à l'ouverture du dossier.
  rgpdInformeA DateTime?

  // Mutuelle — voir module Mutuelle & tiers payant. mutuelleRefuseeA trace un
  // refus explicite du client de la renseigner (le blocage du reste à charge
  // ne s'applique alors plus, mais le refus reste tracé). numeroContrat et
  // plateforme sont distincts du numéro d'adhérent : une mutuelle peut avoir
  // les deux, un seul des deux, ou aucun.
  mutuelleNom            String?
  mutuelleNumeroAdherent String?
  mutuelleNumeroContrat  String?
  mutuellePlateforme     String? // plateforme de tiers payant (Viamédis, Almerys, iSanté…) — voir model PlateformeTiersPayant
  mutuelleRenseigneeA    DateTime?
  mutuelleRefuseeA       DateTime?
  mutuelleExtraitParOcrA DateTime? // horodatage d'une extraction automatique — null si saisie/corrigée à la main

  // Mutuelle secondaire/surcomplémentaire — fonctionne à l'identique de la
  // mutuelle principale ci-dessus (mêmes règles), en plus d'elle et non à sa
  // place : un dossier peut avoir les deux, ou seulement la principale.
  // L'extraction OCR de carte mutuelle ne cible aujourd'hui que la
  // principale — la secondaire se renseigne à la main.
  mutuelle2Nom            String?
  mutuelle2NumeroAdherent String?
  mutuelle2NumeroContrat  String?
  mutuelle2Plateforme     String?
  mutuelle2RenseigneeA    DateTime?
  mutuelle2RefuseeA       DateTime?

  // Mini-audit vocal : synthèse IA, jamais actée sans validation humaine explicite.
  syntheseBesoin           String? // texte libre généré par IA puis édité par l'humain
  syntheseBesoinValideeA   DateTime? // horodatage de la validation humaine — null tant que non validée
  syntheseBesoinValideePar String? // qui a validé

  documents          Document[]
  ordonnances        Ordonnance[]
  evenements         Evenement[]
  propositions       Proposition[]
  codesSignatureSms  CodeSignatureSms[]

  @@index([nom, prenom])
  @@index([foyerId])
  @@index([numeroSecuriteSociale])
}

enum RoleAssure {
  NON_RENSEIGNE
  ASSURE
  AYANT_DROIT
}

/// Code à usage unique envoyé par SMS (Twilio) pour la signature électronique
/// du consentement RGPD — alternative à la validation à l'écran, à la
/// signature au stylet, ou au document papier scanné (voir carte RGPD).
/// codeHash : jamais le code en clair en base, même à très courte durée de
/// vie — comparaison par hachage, comme un mot de passe.
model CodeSignatureSms {
  id         String    @id @default(cuid())
  creeA      DateTime  @default(now())
  personneId String
  personne   Personne  @relation(fields: [personneId], references: [id])
  codeHash   String
  expireA    DateTime
  utiliseA   DateTime?
  tentatives Int       @default(0)

  @@index([personneId])
}

/// Prescription (optique) ou compte-rendu d'analyse (audition), avec renouvellement.
model Ordonnance {
  id             String         @id @default(cuid())
  creeA          DateTime       @default(now())
  personneId     String
  personne       Personne       @relation(fields: [personneId], references: [id])
  type           TypeOrdonnance
  dateEmission   DateTime
  dateExpiration DateTime? // pour calculer la "fraîcheur" (ordonnance périmée)
  emisePar       String? // praticien prescripteur
  documentId     String?        @unique
  document       Document?      @relation(fields: [documentId], references: [id])

  // Mesures de correction (type OPTIQUE uniquement) — telles que lues sur
  // l'ordonnance, en cylindre négatif (convention des ophtalmologistes
  // français). Le cylindre positif utilisé par les verriers/opticiens est
  // calculé à la volée à l'affichage (lib/optique.ts), jamais stocké en
  // double pour ne jamais désynchroniser l'un de l'autre.
  sphereOD      Float?
  cylindreOD    Float?
  axeOD         Int?
  additionOD    Float?
  sphereOG      Float?
  cylindreOG    Float?
  axeOG         Int?
  additionOG    Float?
  extraitParOcrA DateTime? // horodatage d'une extraction automatique — null si saisie/corrigée à la main

  // Cabinet et praticien tels que lus sur l'ordonnance — toujours stockés
  // ici tels quels (même sans FINESS valide), indépendamment de l'annuaire
  // Cabinet ci-dessous qui n'archive que les cabinets identifiés par un
  // FINESS valide (seul numéro obligatoire pour y figurer ; le RPPS reste
  // une information ponctuelle sur l'ordonnance, pas une clé d'annuaire).
  cabinetNom String?
  finess     String? // FINESS du cabinet — 9 chiffres, validé avant stockage (lib/optique.ts)
  rpps       String? // RPPS du praticien, si présent sur l'ordonnance — 11 chiffres, validé avant stockage

  // Adaptation par un opticien (décret du 27 mai 2016 : un opticien peut
  // adapter une prescription existante dans certaines limites) — mêmes
  // mesures que ci-dessus mais pour la correction adaptée, avec sa propre
  // date. Tant que `dateModification` est renseignée, ce sont CES valeurs
  // qui font foi (lib/optique.ts > valeursActives), jamais celles du
  // médecin en même temps — jamais fusionnées champ par champ.
  sphereOdModifiee   Float?
  cylindreOdModifiee Float?
  axeOdModifiee      Int?
  additionOdModifiee Float?
  sphereOgModifiee   Float?
  cylindreOgModifiee Float?
  axeOgModifiee      Int?
  additionOgModifiee Float?
  modifieePar        String? // nom de l'opticien ayant adapté la prescription
  dateModification   DateTime?

  @@index([personneId])
}

/// Annuaire des cabinets déjà rencontrés (via OCR ou saisie manuelle),
/// alimenté au fur et à mesure — sert à la recherche/autocomplétion lors
/// d'une saisie manuelle (OCR défaillant, ou création manuelle du dossier)
/// plutôt que de tout retaper à chaque fois. Un cabinet n'y figure que
/// si un FINESS valide a pu être lu — c'est la clé qui l'identifie.
model Cabinet {
  id          String       @id @default(cuid())
  creeA       DateTime     @default(now())
  misAJourA   DateTime     @updatedAt
  nom         String
  finess      String       @unique

  @@index([nom])
}

/// Annuaire des plateformes de tiers payant (Viamédis, Almerys, iSanté,
/// SP Santé, Carte Blanche…) et de leurs contacts professionnels —
/// seeded avec les acteurs majeurs connus (nom seulement, vérifié), le
/// reste (email/téléphone pro, autres plateformes) se complète et se
/// corrige à la main dans la carte Mutuelle & tiers payant. Sert à
/// l'autocomplétion et de carnet d'adresses pour l'envoi des demandes.
model PlateformeTiersPayant {
  id              String   @id @default(cuid())
  creeA           DateTime @default(now())
  misAJourA       DateTime @updatedAt
  nom             String   @unique
  emailPro        String?
  telephonePro    String?

  @@index([nom])
}

/// Annuaire des mutuelles/complémentaires santé (AMC) — configuré depuis le
/// Super Admin, sert à automatiser les demandes de prise en charge et de
/// paiement (au-delà du simple carnet d'adresses PlateformeTiersPayant :
/// une Mutuelle porte ses propres identifiants d'accès portail).
///
/// ⚠️ identifiantAcces/motDePasseAcces sont stockés tels quels (aucun
/// chiffrement au repos) — même limite, assumée et documentée, que le reste
/// de l'application vis-à-vis de l'hébergement HDS (voir
/// docs/conformite-hds.md) : ne pas y placer d'identifiants réels tant que
/// l'hébergement n'est pas durci en conséquence.
model Mutuelle {
  id         String  @id @default(cuid())
  creeA      DateTime @default(now())
  modifieA   DateTime @updatedAt
  nom        String  @unique
  plateforme String? // nom de la plateforme de tiers payant utilisée (Viamédis, Almerys...), texte libre

  identifiantAcces String? // login du portail pro de cette mutuelle
  motDePasseAcces  String? // voir avertissement ci-dessus
  urlPortail       String?

  telephone String?
  email     String?

  delaiRemboursementJoursConnu Int? // délai habituel constaté, informatif seulement

  actif     Boolean @default(true)
  remarques String?

  @@index([nom])
}

/// Annuaire des caisses de sécurité sociale (AMO — assurance maladie
/// obligatoire : CPAM, MSA...) — plus sobre que Mutuelle : pas d'identifiants
/// de portail par caisse (l'accès pro passe par un système national unique,
/// pas par caisse), juste de quoi contacter la bonne caisse pour un dossier.
model CaisseAmo {
  id         String   @id @default(cuid())
  creeA      DateTime @default(now())
  modifieA   DateTime @updatedAt
  nom        String   @unique // ex. "CPAM de Paris"
  codeCaisse String?
  telephone  String?
  email      String?
  adresse    String?
  actif      Boolean  @default(true)
  remarques  String?

  @@index([nom])
}

enum TypeOrdonnance {
  OPTIQUE
  AUDITION
}

/// Pièce justificative transverse : carte Vitale, carte mutuelle, ordonnance
/// scannée, devis signé, etc. Le contenu binaire n'est pas stocké en base —
/// seule la référence de stockage (à définir avec l'hébergeur HDS) l'est.
model Document {
  id             String       @id @default(cuid())
  creeA          DateTime     @default(now())
  personneId     String
  personne       Personne     @relation(fields: [personneId], references: [id])
  type           TypeDocument
  nomFichier     String
  cheminStockage String // référence vers le stockage de fichiers (S3-compatible HDS en prod)
  ordonnance     Ordonnance?

  // Renseigné pour un DEVIS_SIGNE issu d'une signature au stylet ou d'un
  // papier scanné — distingue de quelle proposition précise il s'agit
  // (un même dossier peut avoir plusieurs devis au fil du temps).
  propositionId String?
  proposition   Proposition? @relation(fields: [propositionId], references: [id])

  @@index([personneId])
  @@index([propositionId])
}

enum TypeDocument {
  CARTE_VITALE
  CARTE_MUTUELLE
  ORDONNANCE
  JUSTIFICATIF
  DEVIS_SIGNE
  CONSENTEMENT_RGPD
  AUTRE
}

// --- Module Produits & catalogue (Lot 2, optique V1) ------------------------
// Source : docs/dossier-cadrage.md > "Module — Produits & catalogue".
// "Donner accès, au moment de composer une proposition, à des produits réels
// et disponibles — jamais à une promesse théorique déconnectée du stock ou du
// tarif fournisseur du jour."

/// Point de vente — nécessaire pour le stock multi-magasin (référence marché
/// MyEasyOptic citée dans docs/dossier-cadrage.md). Géré depuis le Super
/// Admin (voir /super-admin/magasins) : création et renommage, jamais de
/// suppression tant qu'un stock ou un compte utilisateur y est rattaché
/// (perte de traçabilité sinon) — voir /api/magasins.
///
/// La fiche complète (adresse, FINESS, numéros d'agrément...) est distincte
/// de la Societe : un magasin peut être un établissement secondaire avec son
/// propre SIRET/FINESS, ou simplement un point de vente rattaché à la
/// société pour tout le reste (siret vide = hérite de Societe à l'affichage,
/// voir lib/entiteLegale.ts). Toutes ces rubriques sont volontairement
/// optionnelles en base — voir champsObligatoiresManquantsMagasin pour
/// savoir lesquelles sont exigées par le métier avant utilisation réelle.
model Magasin {
  id         String  @id @default(cuid())
  nom        String
  ville      String?
  adresse    String?
  codePostal String?
  telephone  String?
  email      String?
  siret      String?
  finess     String? // établissement de santé — obligatoire pour un point de vente d'optique/audition

  // Un magasin peut pratiquer l'une ou l'autre activité, ou les deux — voir
  // Produit.activite (TypeOrdonnance) pour le même distinguo côté catalogue.
  numeroAgrementOptique String? // opticien-lunetier
  numeroAgrementAudio   String? // audioprothésiste

  responsable String? // nom du responsable/gérant de ce point de vente

  stocks       Stock[]
  utilisateurs Utilisateur[]
}

/// Entité juridique acheteuse du logiciel — un seul enregistrement (singleton
/// applicatif : toujours lu/écrit via l'id fixe "singleton", voir
/// /api/super-admin/societe). Sert d'identité par défaut sur les documents
/// générés (devis, facture...) et regroupe les mentions légales obligatoires
/// pour un opticien/audioprothésiste : SIRET, RCS, TVA intracommunautaire,
/// assurance RC Pro, représentant légal... Toutes les rubriques restent
/// modifiables à tout moment depuis le Super Admin ; voir
/// lib/entiteLegale.ts > champsObligatoiresManquantsSociete pour savoir
/// lesquelles sont exigées avant un usage réel avec des clients.
model Societe {
  id       String   @id @default(cuid())
  creeA    DateTime @default(now())
  modifieA DateTime @updatedAt

  raisonSociale               String?
  formeJuridique              String? // SARL, SAS, EI, SELARL...
  siret                       String? @unique // 14 chiffres — le SIREN est ses 9 premiers chiffres, jamais stocké en double
  numeroTvaIntracommunautaire String?
  rcs                         String? // ex. "RCS Paris 123 456 789" — format libre, variable selon la ville d'immatriculation
  capitalSocial               String? // texte libre : "non applicable" pour une EI/EIRL, montant sinon
  codeApe                     String?

  adresse    String?
  codePostal String?
  ville      String?

  telephone String?
  email     String?
  siteWeb   String?

  representantLegal String? // nom du dirigeant/gérant

  numeroFiness String? // si un numéro unique couvre toute la société — sinon renseigné par magasin

  assuranceRcProNom    String? // assurance responsabilité civile professionnelle — obligatoire pour une profession de santé
  assuranceRcProNumero String?

  // Coordonnées bancaires pour les remboursements mutuelle/sécurité sociale,
  // si centralisés au niveau société plutôt que par magasin.
  iban String?
  bic  String?
}

/// Article catalogue : monture, verre, lentille ou accessoire (V1 optique),
/// ou appareil auditif/accessoire audio (voir TypeProduit). Le tarif courant
/// (prixTTC) est toujours celui affiché — jamais une valeur mise en cache :
/// chaque changement crée une ligne HistoriquePrix plutôt que d'écraser
/// silencieusement l'ancien prix (traçabilité en cas de litige).
///
/// Colonnes reprises du modèle d'import CSV en masse (voir
/// src/lib/importProduitsCsv.ts) : toutes optionnelles à la création/import
/// sauf reference/type/prixTTC, mais toutes présentes dans le formulaire de
/// création produit. `description` n'est jamais saisie librement : elle est
/// recalculée automatiquement (voir src/lib/descriptionProduit.ts) à partir
/// de modele/taille/coloris/nomenclature/prixTTC/tauxTva/prixVenteHT, pour
/// être reprise telle quelle dans les devis/propositions et les documents
/// (actuels et à venir) à destination des mutuelles, de la sécurité sociale
/// et du client.
model Produit {
  id                 String         @id @default(cuid())
  creeA              DateTime       @default(now())
  modifieA           DateTime       @updatedAt
  type               TypeProduit
  activite           TypeOrdonnance @default(OPTIQUE) // ligne d'activité (optique/audition) — colonne CSV "activité"
  reference          String         @unique
  qrcode             String?        @unique // code du QR apposé sur l'article — distinct de `reference` (peut provenir d'un système externe) ; à défaut, le QR généré par l'application encode `reference`
  categorie          String? // sous-catégorie libre, distincte de `type` — colonne CSV "catégorie"
  marque             String
  modele             String // "nom (modèle)" dans le CSV
  taille             String?
  coloris            String?
  nomenclature       String? // code LPP/nomenclature sécurité sociale, si applicable
  description        String? // recalculée automatiquement — voir commentaire ci-dessus, jamais éditable directement
  prixAchat          Int? // en centimes — prix d'achat HT (coût fournisseur, hors taxes)
  coefficient        Float? // multiplicateur prix d'achat HT → prix de vente HT — voir src/lib/tarificationProduit.ts
  prixTTC            Int // en centimes — "prix public TTC"
  tauxTva            Float? // ex. 0.2 pour 20 %
  prixVenteHT        Int? // en centimes — prixAchat × coefficient, avant application de la TVA
  plafondRemise      Float? // ex. 0.1 pour 10 %
  remarque           String?
  dateDerniereSortie DateTime?
  statut             StatutProduit  @default(ACTIF)
  garantieMois       Int? // durée de garantie constructeur, si connue — voir module SAV

  // Fournisseur de l'article — annuaire séparé (contact, SAV, conditions
  // commerciales). Lien interne : jamais imprimé sur un document commercial
  // (devis, facture), transmis uniquement avec la marque sur les demandes de
  // prise en charge mutuelle/sécurité sociale — voir PropositionLigne.
  fournisseurId String?
  fournisseur   Fournisseur? @relation(fields: [fournisseurId], references: [id])

  stocks            Stock[]
  historiquePrix    HistoriquePrix[]
  lignesProposition PropositionLigne[]
  lignesCommande    CommandeLigne[]

  @@index([type])
  @@index([marque])
  @@index([activite])
  @@index([fournisseurId])
}

enum TypeProduit {
  MONTURE
  VERRE
  LENTILLE
  ACCESSOIRE
  APPAREIL_AUDITIF
  ECOUTEUR
  PILE_AUDITIVE
  ACCESSOIRE_AUDITIF
}

enum StatutProduit {
  ACTIF
  RUPTURE
  DISCONTINUE
}

/// Annuaire des fournisseurs par référence article : nom, contact commercial,
/// SAV, conditions commerciales, remarques. Le lien fournisseur reste interne
/// à l'application : jamais imprimé sur les documents commerciaux (devis,
/// facture) — seule la marque l'est — mais transmis (nom du fournisseur +
/// marque) sur les demandes de prise en charge mutuelle/sécurité sociale, où
/// il est nécessaire au traitement du dossier (voir PropositionLigne et
/// src/lib/demandesPriseEnCharge.ts).
model Fournisseur {
  id                     String   @id @default(cuid())
  creeA                  DateTime @default(now())
  modifieA               DateTime @updatedAt
  nom                    String   @unique
  contact                String?
  sav                    String?
  conditionsCommerciales String?
  remarques              String?

  produits Produit[]

  @@index([nom])
}

/// Disponibilité d'un produit par magasin. "La disponibilité multi-magasin
/// est consultable avant de promettre un délai au client" (critère
/// d'acceptation V1). delaiJoursReappro renseigné quand quantite = 0, pour
/// donner un délai réaliste plutôt qu'une simple rupture sans horizon.
model Stock {
  id                String   @id @default(cuid())
  modifieA          DateTime @updatedAt
  produitId         String
  produit           Produit  @relation(fields: [produitId], references: [id])
  magasinId         String
  magasin           Magasin  @relation(fields: [magasinId], references: [id])
  quantite          Int      @default(0)
  quantiteReservee  Int      @default(0) // engagée sur une proposition en cours, pas encore livrée
  delaiJoursReappro Int? // renseigné si quantite = 0 : délai fournisseur estimé

  @@unique([produitId, magasinId])
  @@index([magasinId])
}

/// Historique de prix — jamais écrasé, pour pouvoir justifier a posteriori le
/// tarif affiché à un client à une date donnée.
model HistoriquePrix {
  id         String   @id @default(cuid())
  effectifA  DateTime @default(now())
  produitId  String
  produit    Produit  @relation(fields: [produitId], references: [id])
  prixTTC    Int
  modifiePar String? // email de l'utilisateur ayant changé le prix

  @@index([produitId])
}

// --- Module Devis & proposition (Lot 3) --------------------------------------
// Source : docs/dossier-cadrage.md > "Module — Devis & proposition".
// "Composer une proposition adaptée au besoin et au budget, en gardant la
// trace de TOUTES les versions, alternatives et du choix final — jamais un
// simple document qui écrase le précédent."

/// Une proposition n'est jamais supprimée, même refusée ou remplacée — elle
/// reste consultable dans l'historique du dossier (critère d'acceptation V1).
/// "remplace" trace explicitement qu'une nouvelle version succède à une
/// proposition précédente, sans effacer celle-ci.
model Proposition {
  id           String            @id @default(cuid())
  creeA        DateTime          @default(now())
  modifieA     DateTime          @updatedAt
  personneId   String
  personne     Personne          @relation(fields: [personneId], references: [id])
  statut       StatutProposition @default(BROUILLON)
  envoyeeA     DateTime?
  decideeA     DateTime?
  notes        String?
  cent100Sante Boolean           @default(false) // dispositif réglementé optique — voir docs/dossier-cadrage.md

  // Reste à charge réel, mis à jour uniquement par un accord de prise en
  // charge mutuelle (module Mutuelle & tiers payant) — jamais recalculé
  // silencieusement ailleurs. Nul tant qu'aucun accord n'a été enregistré.
  resteAChargeTTC Int?

  remplaceId   String?      @unique
  remplace     Proposition? @relation("VersionProposition", fields: [remplaceId], references: [id])
  remplaceePar Proposition? @relation("VersionProposition")

  // Comment l'acceptation a été recueillie — voir ModeSignature. Nul tant
  // que la proposition n'est pas (encore) acceptée.
  signatureMode ModeSignature?

  lignes             PropositionLigne[]
  demandes           DemandePriseEnCharge[]
  commandes          Commande[]
  documentsSignature Document[]

  @@index([personneId])
  @@index([statut])
}

enum StatutProposition {
  BROUILLON
  ENVOYEE
  ACCEPTEE
  REFUSEE
  EXPIREE
}

/// Comment le client a signé son acceptation d'une proposition (ou son
/// consentement RGPD) — même logique, même choix pour les deux : validation
/// à l'écran par un membre de l'équipe, signature au stylet/écran tactile,
/// code à usage unique par SMS, ou document papier signé puis scanné.
enum ModeSignature {
  ECRAN
  PAD
  SMS
  PAPIER
}

/// Ligne de proposition. prixUnitaireTTC et libelleProduit sont un instantané
/// pris au moment de l'ajout : le tarif catalogue peut changer après coup
/// (HistoriquePrix), mais la proposition déjà composée garde le prix promis
/// au client à cet instant précis — jamais recalculé rétroactivement.
model PropositionLigne {
  id              String      @id @default(cuid())
  creeA           DateTime    @default(now())
  propositionId   String
  proposition     Proposition @relation(fields: [propositionId], references: [id])
  produitId       String
  produit         Produit     @relation(fields: [produitId], references: [id])
  libelleProduit  String // instantané "marque modèle" au moment de l'ajout
  quantite        Int         @default(1)
  prixUnitaireTTC Int // instantané, en centimes

  // Instantanés supplémentaires pris au moment de l'ajout, comme
  // libelleProduit/prixUnitaireTTC ci-dessus — jamais recalculés après coup.
  // descriptionProduit et marqueProduit sont repris dans les devis/documents
  // publics (marque seule sur devis/facture, jamais le fournisseur).
  // fournisseurNom n'est jamais imprimé sur devis/facture : transmis
  // uniquement, avec marqueProduit, sur les demandes de prise en charge
  // mutuelle/sécurité sociale, où il est nécessaire au traitement.
  descriptionProduit String?
  marqueProduit      String?
  fournisseurNom     String?

  // Correction optique (catégorie VERRE uniquement) — préremplie depuis la
  // dernière ordonnance OPTIQUE du dossier au moment de l'ajout (valeurs
  // actives : adaptation opticien si elle existe, sinon prescription
  // médecin — voir lib/optique.ts), mais PAS un instantané figé comme les
  // champs ci-dessus : modifiable à tout moment (bouton dédié dans chaque
  // document — proposition, facture, commande, SAV), y compris une fois la
  // proposition envoyée/acceptée, pour corriger une erreur de fabrication
  // constatée après coup sans recréer toute la ligne.
  sphereOD    Float?
  cylindreOD  Float?
  axeOD       Int?
  additionOD  Float?
  sphereOG    Float?
  cylindreOG  Float?
  axeOG       Int?
  additionOG  Float?

  @@index([propositionId])
}

// --- Module Mutuelle & tiers payant (Lot 4) ----------------------------------
// Source : docs/dossier-cadrage.md > "Module — Mutuelle & tiers payant".
// "Remplacer les échanges manuels par mail/téléphone avec les mutuelles par
// un flux suivi et tracé — plutôt qu'une découverte du problème à
// l'encaissement." La télétransmission réelle (portail tiers, DRE) n'est PAS
// intégrée ici : la faisabilité technique n'a pas été vérifiée (voir le
// "Point d'attention" du module). Ce lot trace le flux manuellement.

/// Demande de prise en charge, déclenchée à l'acceptation d'une Proposition.
/// "Chaque demande envoyée est visible avec son statut et son délai — pas de
/// demande perdue faute de suivi" (critère d'acceptation V1).
model DemandePriseEnCharge {
  id            String                @id @default(cuid())
  creeA         DateTime              @default(now())
  modifieA      DateTime              @updatedAt
  propositionId String
  proposition   Proposition           @relation(fields: [propositionId], references: [id])
  personneId    String
  statut        StatutDemandeMutuelle @default(A_ENVOYER)
  envoyeeA      DateTime?
  reponseA      DateTime?

  // À quelle mutuelle du dossier cette demande se rapporte — Personne peut
  // porter une mutuelle principale ET une secondaire/surcomplémentaire
  // (mêmes règles pour les deux, voir Personne.mutuelle2*) : une demande
  // par mutuelle, jamais fusionnées.
  rang RangMutuelle @default(PRINCIPALE)

  // Renseignés uniquement à l'accord — jamais recalculés ailleurs.
  montantPriseEnChargeTTC Int?
  motifRefus              String?

  // "Code paiement" — jeton unique généré dès que le montant de l'accord
  // est connu, imprimé en QR (voir /api/demandes-mutuelle/:id/code-paiement).
  // Fonctionne comme un "pseudo tiers payant" : que l'opticien pratique ou
  // non le tiers payant réel avec cette mutuelle, ce code sert de moyen de
  // rapprochement à saisir/scanner quand la somme est effectivement reçue
  // de la mutuelle — ou même avant, si une caution client a été prise en
  // attendant son propre remboursement. Aléatoire (128 bits, crypto.randomBytes)
  // et unique : "chiffré" au sens non-devinable/vérifiable, pas un secret
  // réversible — voir lib/codePaiement.ts.
  codePaiement String?   @unique
  recuLeA      DateTime?
  recuPar      String? // email de qui a validé la réception

  // FINESS du cabinet et RPPS du praticien prescripteur — copiés depuis la
  // dernière Ordonnance OPTIQUE du dossier au moment de la création de
  // cette demande (instantané, comme PropositionLigne.prixUnitaireTTC :
  // jamais recalculés après coup) — une mutuelle exige ces identifiants
  // sur toute demande de prise en charge.
  finess String?
  rpps   String?

  // Renseignés uniquement quand l'envoi a été fait automatiquement par
  // email depuis le logiciel (voir lib/emailTiersPayant.ts) — restent nuls
  // pour un envoi marqué manuellement (portail tiers, courrier...).
  canalEnvoi        String?
  destinataireEnvoi String?

  @@index([propositionId])
  @@index([personneId])
  @@index([statut])
}

enum StatutDemandeMutuelle {
  A_ENVOYER
  ENVOYEE
  EN_ATTENTE
  ACCORD
  REFUS
}

enum RangMutuelle {
  PRINCIPALE
  SECONDAIRE
}

// --- Module Commande & livraison (Lot 5) -------------------------------------
// Source : docs/dossier-cadrage.md > "Module — Commande & livraison".
// "Faire exister, une fois une proposition acceptée (et l'accord mutuelle
// obtenu quand nécessaire), une chaîne commande → réception → contrôle →
// remise au client → ajustement, sans perte d'information entre chaque
// étape." Les flux fournisseurs réels (format de commande, suivi
// transporteur) ne sont PAS intégrés — comme pour la mutuelle, la
// faisabilité par fournisseur n'a pas été vérifiée. Ce lot trace la chaîne
// manuellement.

/// "Aucune commande ne peut être passée sans proposition acceptée liée"
/// (critère d'acceptation V1). Les lignes sont un instantané des lignes de
/// la proposition au moment du passage de commande (même principe que
/// PropositionLigne : jamais recalculées après coup).
/// propositionId et savId sont tous deux optionnels mais mutuellement
/// significatifs : une commande née d'une vente porte propositionId (V1 des
/// lots 3-6), une commande de remplacement née d'un échange SAV porte savId
/// à la place (voir module SAV, Lot 7), une vente directe au comptoir (sans
/// devis préalable) ne porte ni l'un ni l'autre — jamais les deux à la fois,
/// vérifié côté application plutôt que par contrainte SQL, comme le reste
/// de ce schéma.
model Commande {
  id               String         @id @default(cuid())
  creeA            DateTime       @default(now())
  modifieA         DateTime       @updatedAt
  propositionId    String?
  proposition      Proposition?   @relation(fields: [propositionId], references: [id])
  savId            String?        @unique
  sav              SAV?           @relation(fields: [savId], references: [id])
  personneId       String
  statut           StatutCommande @default(A_PASSER)
  passeeA          DateTime?
  confirmeeA       DateTime?
  recueA           DateTime?
  controleeA       DateTime?
  delaiJoursEstime Int? // délai fournisseur communiqué au moment du passage

  lignes    CommandeLigne[]
  livraison Livraison?

  @@index([propositionId])
  @@index([savId])
  @@index([personneId])
  @@index([statut])
}

enum StatutCommande {
  A_PASSER
  PASSEE
  CONFIRMEE
  RECUE
  CONTROLEE
}

model CommandeLigne {
  id                 String   @id @default(cuid())
  commandeId         String
  commande           Commande @relation(fields: [commandeId], references: [id])
  produitId          String
  produit            Produit  @relation(fields: [produitId], references: [id])
  libelleProduit     String // instantané, comme PropositionLigne
  descriptionProduit String? // instantané de Produit.description — repris sur la facture (voir PropositionLigne)
  quantite           Int      @default(1)
  prixUnitaireTTC    Int? // instantané — renseigné pour une vente directe (pas de proposition dont dériver un prix)
  numeroSerie        String? // renseigné au contrôle — utile pour les appareils auditifs

  // Correction optique (catégorie VERRE) — copiée depuis la PropositionLigne
  // d'origine (ou préremplie directement pour une vente directe), modifiable
  // à tout moment comme sur PropositionLigne (voir son commentaire).
  sphereOD    Float?
  cylindreOD  Float?
  axeOD       Int?
  additionOD  Float?
  sphereOG    Float?
  cylindreOG  Float?
  axeOG       Int?
  additionOG  Float?

  savs SAV[]

  @@index([commandeId])
}

/// "Un ajustement fait au moment de la remise est enregistré dans le
/// dossier" (critère d'acceptation V1) — jamais une simple note orale
/// perdue après coup.
model Livraison {
  id                 String          @id @default(cuid())
  creeA              DateTime        @default(now())
  modifieA           DateTime        @updatedAt
  commandeId         String          @unique
  commande           Commande        @relation(fields: [commandeId], references: [id])
  personneId         String
  statut             StatutLivraison @default(PROGRAMMEE)
  dateProgrammee     DateTime?
  remiseA            DateTime?
  ajustementDemande  String? // note d'ajustement/réglage demandé, tracée
  ajustementDemandeA DateTime?
  clotureeA          DateTime?

  facture Facture?
  savs    SAV[]

  @@index([commandeId])
  @@index([personneId])
  @@index([statut])
}

enum StatutLivraison {
  PROGRAMMEE
  REMISE
  AJUSTEMENT_DEMANDE
  CLOTUREE
}

// --- Module Facturation & financement (Lot 6, V1 hors financement/crédit) ---
// Source : docs/dossier-cadrage.md > "Module — Facturation & financement".
// "Solder financièrement un dossier — acompte, encaissement, facture, avoir,
// impayé, relance — sans perdre le lien avec le client ni avec le reste du
// dossier." Le financement/paiement fractionné (V1.1) est explicitement
// reporté par le cadrage — cadre réglementaire du crédit à la consommation à
// valider avec un juriste avant réalisation. Le terminal de paiement réel et
// l'export comptabilité ne sont PAS intégrés ici (même limite que les lots
// précédents : faisabilité non vérifiée).

/// "Une facture reprend automatiquement le reste à charge validé par le
/// module Mutuelle — aucun recalcul manuel" (critère d'acceptation V1) :
/// montantTTC est figé à l'émission depuis Proposition.resteAChargeTTC (ou
/// le total de la proposition si aucune mutuelle n'est intervenue), jamais
/// modifiable ensuite — seul un Avoir peut corriger un montant après coup.
/// "en impayé" (dossier-cadrage) est un état calculé (retard + solde > 0),
/// pas persisté ici — même principe que l'alerte de délai de Commande.
model Facture {
  id                 String        @id @default(cuid())
  creeA              DateTime      @default(now())
  modifieA           DateTime      @updatedAt
  livraisonId        String        @unique
  livraison          Livraison     @relation(fields: [livraisonId], references: [id])
  personneId         String
  statut             StatutFacture @default(EMISE)
  montantTTC         Int // figé à l'émission, jamais recalculé
  delaiPaiementJours Int           @default(30)
  relanceEnvoyeeA    DateTime? // "un impayé après délai génère une tâche de relance visible" (critère V1)
  notes              String?

  paiements Paiement[]
  avoirs    Avoir[]

  @@index([livraisonId])
  @@index([personneId])
  @@index([statut])
}

enum StatutFacture {
  EMISE
  PAYEE_PARTIELLEMENT
  SOLDEE
}

/// "Chaque encaissement est un événement daté, jamais une simple mise à
/// jour d'un solde" (dossier-cadrage) — append-only, jamais modifié.
model Paiement {
  id         String   @id @default(cuid())
  creeA      DateTime @default(now())
  factureId  String
  facture    Facture  @relation(fields: [factureId], references: [id])
  montantTTC Int
  moyen      String? // espèces, CB, chèque… texte libre en V1 (pas de terminal intégré)

  @@index([factureId])
}

/// "Un avoir reste lié à la facture d'origine — jamais un document
/// indépendant" (critère d'acceptation V1).
model Avoir {
  id         String   @id @default(cuid())
  creeA      DateTime @default(now())
  factureId  String
  facture    Facture  @relation(fields: [factureId], references: [id])
  montantTTC Int
  motif      String?

  @@index([factureId])
}

// --- Module SAV (Lot 7) -------------------------------------------------------
// Source : docs/dossier-cadrage.md > "Module — SAV". "Traiter un incident
// après livraison (casse, gêne, panne d'appareil auditif, retour) en le
// rattachant au dossier et à la livraison d'origine, plutôt que comme un
// nouveau dossier déconnecté." Reporté après la V1 dans le cadrage
// d'origine faute d'historique réel de livraisons — les Lots 5 et 6 en
// produisent désormais un, ce module peut donc être réalisé. Le suivi
// garantie fournisseur réel (portail, conditions par contrat) n'est PAS
// intégré — même limite que les lots précédents.

/// "Un SAV référence toujours une Livraison ou un Produit existant du
/// dossier — pas de saisie libre déconnectée" (critère d'acceptation V1) :
/// structurel ici, jamais un SAV sans Livraison. commandeLigneId cible en
/// plus une ligne précise (utile en audition : quel appareil exact, quel
/// numéro de série).
model SAV {
  id              String         @id @default(cuid())
  creeA           DateTime       @default(now())
  modifieA        DateTime       @updatedAt
  livraisonId     String
  livraison       Livraison      @relation(fields: [livraisonId], references: [id])
  commandeLigneId String?
  commandeLigne   CommandeLigne? @relation(fields: [commandeLigneId], references: [id])
  personneId      String
  statut          StatutSAV      @default(OUVERT)
  motif           String // description de l'incident (casse, gêne, panne, retour…)

  diagnostiqueA        DateTime?
  diagnostic           String?
  decision             DecisionSAV?
  garantieConstructeur Boolean      @default(false)
  garantieMagasin      Boolean      @default(false)

  traitementA DateTime?
  clotureA    DateTime?
  noteCloture String?

  /// "Un SAV clôturé par un échange déclenche automatiquement une nouvelle
  /// Commande si nécessaire" (critère d'acceptation V1) — commande de
  /// remplacement, jamais rattachée à une proposition (voir Commande).
  commandeRemplacement Commande?

  @@index([livraisonId])
  @@index([personneId])
  @@index([statut])
}

enum StatutSAV {
  OUVERT
  DIAGNOSTIQUE
  EN_TRAITEMENT
  CLOTURE
}

enum DecisionSAV {
  REPARATION
  ECHANGE
  REMBOURSEMENT
}

// --- Modèles de documents (configurables depuis le Super Admin) -------------
// "Donne-moi un espace pour configurer ces documents à ma guise et que je
// puisse sauvegarder et switcher si je le souhaite" — plusieurs modèles
// nommés par type de document, un seul actif à la fois par type (basculer
// entre eux ne perd jamais les autres, contrairement à un simple champ de
// configuration unique écrasé à chaque changement).

enum TypeModeleDocument {
  FACTURE
  DEVIS_NORMALISE
  DEVIS_NON_NORMALISE
  ACCORD_TIERS_PAYANT
}

/// Un modèle configure l'en-tête (identité affichée sur le document) et le
/// pied de page (mentions légales, CGV...) d'un type de document précis.
/// "actif" désigne celui utilisé pour générer le PDF de ce type — un seul à
/// la fois (voir /api/super-admin/modeles-documents/:id/activer), les
/// autres restent enregistrés et réactivables à tout moment.
model ModeleDocument {
  id       String             @id @default(cuid())
  creeA    DateTime           @default(now())
  modifieA DateTime           @updatedAt
  type     TypeModeleDocument
  nom      String // nom donné par l'utilisateur, pour distinguer plusieurs modèles du même type
  actif    Boolean            @default(false)

  enteteNom       String?
  enteteAdresse   String?
  enteteSiret     String?
  enteteTelephone String?
  enteteEmail     String?
  texteIntro      String?
  piedDePage      String?

  @@index([type])
}
