// Schéma de données transverse (Lot 0) + module Dossier client (Lot 1) +
// module Produits & catalogue (Lot 2, optique V1).
// Source : docs/dossier-cadrage.md > "Modèle de données" et modules
// "Dossier client" / "Produits & catalogue".
//
// Principe directeur du dossier de cadrage : un dossier client unique relie
// tout (santé, commerce, mutuelle, commande, livraison, finance, service).
// Les entités des modules non encore réalisés (Proposition, Commande, Facture,
// SAV, ...) ne sont donc PAS créées ici tant que leur lot n'est pas lancé —
// seules les entités des lots déjà réalisés le sont, pour ne pas figer un
// schéma sur des modules non spécifiés en détail.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Fondations transverses (Lot 0) ----------------------------------------

/// Compte collaborateur (comptoir, back-office). Authentification par
/// email + mot de passe (hash bcrypt) — pas de gestion de compte client ici,
/// uniquement le personnel du magasin.
model Utilisateur {
  id                 String          @id @default(cuid())
  creeA              DateTime        @default(now())
  email              String          @unique
  nom                String
  motDePasseHash     String
  role               RoleUtilisateur @default(COLLABORATEUR)
  actif              Boolean         @default(true)
  derniereConnexionA DateTime?
}

enum RoleUtilisateur {
  COLLABORATEUR
  ADMIN
}

/// Journal d'audit : "chaque écriture significative génère un Événement
/// journalisé — jamais de modification silencieuse" (modèle de données).
model Evenement {
  id         String    @id @default(cuid())
  survenuA   DateTime  @default(now())
  type       String // ex: "personne.creee", "consentement.modifie", "document.ajoute"
  entite     String // ex: "Personne"
  entiteId   String // id de l'enregistrement concerné
  acteur     String? // qui a fait l'action (utilisateur/collaborateur) — nullable en attendant l'auth
  canal      String    @default("comptoir") // comptoir | web | voix | automatisation
  donnees    Json? // détail de la modification (avant/après), jamais de données de santé en clair si évitable
  personneId String?
  personne   Personne? @relation(fields: [personneId], references: [id])

  @@index([entite, entiteId])
  @@index([personneId])
  @@index([survenuA])
}

// --- Module Dossier client (Lot 1) ------------------------------------------

/// Regroupement de personnes — cas des mutuelles familiales (assuré + ayants droit).
model Foyer {
  id        String     @id @default(cuid())
  creeA     DateTime   @default(now())
  nom       String? // nom d'usage du foyer, optionnel (ex. "Foyer Dupont")
  personnes Personne[]
}

/// Entité centrale du dossier : identité, coordonnées, préférences de contact,
/// consentements. "Aucun dossier n'a de statut de flux — c'est le socle
/// permanent" (dossier-cadrage.md, Module Dossier client).
model Personne {
  id       String   @id @default(cuid())
  creeA    DateTime @default(now())
  modifieA DateTime @updatedAt

  // État civil
  civilite      String? // M. | Mme | autre — jamais obligatoire
  prenom        String
  nom           String
  dateNaissance DateTime?

  // Coordonnées
  telephone  String?
  email      String?
  adresse    String?
  codePostal String?
  ville      String?

  // Rattachement foyer / rôle assuré
  foyerId    String?
  foyer      Foyer?     @relation(fields: [foyerId], references: [id])
  roleAssure RoleAssure @default(NON_RENSEIGNE)

  // Préférences de contact
  contactPrefereSms   Boolean @default(false)
  contactPrefereEmail Boolean @default(false)

  // Consentements RGPD — "stockés avec horodatage et modifiables à tout
  // moment par le client" (critère d'acceptation V1 du module).
  consentementEmail  Boolean   @default(false)
  consentementEmailA DateTime?
  consentementSms    Boolean   @default(false)
  consentementSmsA   DateTime?

  // Mutuelle — voir module Mutuelle & tiers payant. mutuelleRefuseeA trace un
  // refus explicite du client de la renseigner (le blocage du reste à charge
  // ne s'applique alors plus, mais le refus reste tracé).
  mutuelleNom            String?
  mutuelleNumeroAdherent String?
  mutuelleRenseigneeA    DateTime?
  mutuelleRefuseeA       DateTime?

  // Mini-audit vocal : synthèse IA, jamais actée sans validation humaine explicite.
  syntheseBesoin           String? // texte libre généré par IA puis édité par l'humain
  syntheseBesoinValideeA   DateTime? // horodatage de la validation humaine — null tant que non validée
  syntheseBesoinValideePar String? // qui a validé

  documents    Document[]
  ordonnances  Ordonnance[]
  evenements   Evenement[]
  propositions Proposition[]

  @@index([nom, prenom])
  @@index([foyerId])
}

enum RoleAssure {
  NON_RENSEIGNE
  ASSURE
  AYANT_DROIT
}

/// Prescription (optique) ou compte-rendu d'analyse (audition), avec renouvellement.
model Ordonnance {
  id             String         @id @default(cuid())
  creeA          DateTime       @default(now())
  personneId     String
  personne       Personne       @relation(fields: [personneId], references: [id])
  type           TypeOrdonnance
  dateEmission   DateTime
  dateExpiration DateTime? // pour calculer la "fraîcheur" (ordonnance périmée)
  emisePar       String? // praticien prescripteur
  documentId     String?        @unique
  document       Document?      @relation(fields: [documentId], references: [id])

  @@index([personneId])
}

enum TypeOrdonnance {
  OPTIQUE
  AUDITION
}

/// Pièce justificative transverse : carte Vitale, carte mutuelle, ordonnance
/// scannée, devis signé, etc. Le contenu binaire n'est pas stocké en base —
/// seule la référence de stockage (à définir avec l'hébergeur HDS) l'est.
model Document {
  id             String       @id @default(cuid())
  creeA          DateTime     @default(now())
  personneId     String
  personne       Personne     @relation(fields: [personneId], references: [id])
  type           TypeDocument
  nomFichier     String
  cheminStockage String // référence vers le stockage de fichiers (S3-compatible HDS en prod)
  ordonnance     Ordonnance?

  @@index([personneId])
}

enum TypeDocument {
  CARTE_VITALE
  CARTE_MUTUELLE
  ORDONNANCE
  JUSTIFICATIF
  DEVIS_SIGNE
  AUTRE
}

// --- Module Produits & catalogue (Lot 2, optique V1) ------------------------
// Source : docs/dossier-cadrage.md > "Module — Produits & catalogue".
// "Donner accès, au moment de composer une proposition, à des produits réels
// et disponibles — jamais à une promesse théorique déconnectée du stock ou du
// tarif fournisseur du jour."

/// Point de vente — nécessaire pour le stock multi-magasin (référence marché
/// MyEasyOptic citée dans docs/dossier-cadrage.md).
model Magasin {
  id     String  @id @default(cuid())
  nom    String
  ville  String?
  stocks Stock[]
}

/// Article catalogue : monture, verre, lentille ou accessoire (V1 optique).
/// Le tarif courant (prixTTC) est toujours celui affiché — jamais une valeur
/// mise en cache : chaque changement crée une ligne HistoriquePrix plutôt que
/// d'écraser silencieusement l'ancien prix (traçabilité en cas de litige).
model Produit {
  id          String        @id @default(cuid())
  creeA       DateTime      @default(now())
  modifieA    DateTime      @updatedAt
  type        TypeProduit
  reference   String        @unique
  marque      String
  modele      String
  description String?
  prixTTC     Int // en centimes — évite les erreurs d'arrondi flottant sur un prix
  statut      StatutProduit @default(ACTIF)

  stocks            Stock[]
  historiquePrix    HistoriquePrix[]
  lignesProposition PropositionLigne[]

  @@index([type])
  @@index([marque])
}

enum TypeProduit {
  MONTURE
  VERRE
  LENTILLE
  ACCESSOIRE
}

enum StatutProduit {
  ACTIF
  RUPTURE
  DISCONTINUE
}

/// Disponibilité d'un produit par magasin. "La disponibilité multi-magasin
/// est consultable avant de promettre un délai au client" (critère
/// d'acceptation V1). delaiJoursReappro renseigné quand quantite = 0, pour
/// donner un délai réaliste plutôt qu'une simple rupture sans horizon.
model Stock {
  id                String   @id @default(cuid())
  modifieA          DateTime @updatedAt
  produitId         String
  produit           Produit  @relation(fields: [produitId], references: [id])
  magasinId         String
  magasin           Magasin  @relation(fields: [magasinId], references: [id])
  quantite          Int      @default(0)
  quantiteReservee  Int      @default(0) // engagée sur une proposition en cours, pas encore livrée
  delaiJoursReappro Int? // renseigné si quantite = 0 : délai fournisseur estimé

  @@unique([produitId, magasinId])
  @@index([magasinId])
}

/// Historique de prix — jamais écrasé, pour pouvoir justifier a posteriori le
/// tarif affiché à un client à une date donnée.
model HistoriquePrix {
  id         String   @id @default(cuid())
  effectifA  DateTime @default(now())
  produitId  String
  produit    Produit  @relation(fields: [produitId], references: [id])
  prixTTC    Int
  modifiePar String? // email de l'utilisateur ayant changé le prix

  @@index([produitId])
}

// --- Module Devis & proposition (Lot 3) --------------------------------------
// Source : docs/dossier-cadrage.md > "Module — Devis & proposition".
// "Composer une proposition adaptée au besoin et au budget, en gardant la
// trace de TOUTES les versions, alternatives et du choix final — jamais un
// simple document qui écrase le précédent."

/// Une proposition n'est jamais supprimée, même refusée ou remplacée — elle
/// reste consultable dans l'historique du dossier (critère d'acceptation V1).
/// "remplace" trace explicitement qu'une nouvelle version succède à une
/// proposition précédente, sans effacer celle-ci.
model Proposition {
  id           String            @id @default(cuid())
  creeA        DateTime          @default(now())
  modifieA     DateTime          @updatedAt
  personneId   String
  personne     Personne          @relation(fields: [personneId], references: [id])
  statut       StatutProposition @default(BROUILLON)
  envoyeeA     DateTime?
  decideeA     DateTime?
  notes        String?
  cent100Sante Boolean           @default(false) // dispositif réglementé optique — voir docs/dossier-cadrage.md

  // Reste à charge réel, mis à jour uniquement par un accord de prise en
  // charge mutuelle (module Mutuelle & tiers payant) — jamais recalculé
  // silencieusement ailleurs. Nul tant qu'aucun accord n'a été enregistré.
  resteAChargeTTC Int?

  remplaceId   String?      @unique
  remplace     Proposition? @relation("VersionProposition", fields: [remplaceId], references: [id])
  remplaceePar Proposition? @relation("VersionProposition")

  lignes   PropositionLigne[]
  demandes DemandePriseEnCharge[]

  @@index([personneId])
  @@index([statut])
}

enum StatutProposition {
  BROUILLON
  ENVOYEE
  ACCEPTEE
  REFUSEE
  EXPIREE
}

/// Ligne de proposition. prixUnitaireTTC et libelleProduit sont un instantané
/// pris au moment de l'ajout : le tarif catalogue peut changer après coup
/// (HistoriquePrix), mais la proposition déjà composée garde le prix promis
/// au client à cet instant précis — jamais recalculé rétroactivement.
model PropositionLigne {
  id              String      @id @default(cuid())
  creeA           DateTime    @default(now())
  propositionId   String
  proposition     Proposition @relation(fields: [propositionId], references: [id])
  produitId       String
  produit         Produit     @relation(fields: [produitId], references: [id])
  libelleProduit  String // instantané "marque modèle" au moment de l'ajout
  quantite        Int         @default(1)
  prixUnitaireTTC Int // instantané, en centimes

  @@index([propositionId])
}

// --- Module Mutuelle & tiers payant (Lot 4) ----------------------------------
// Source : docs/dossier-cadrage.md > "Module — Mutuelle & tiers payant".
// "Remplacer les échanges manuels par mail/téléphone avec les mutuelles par
// un flux suivi et tracé — plutôt qu'une découverte du problème à
// l'encaissement." La télétransmission réelle (portail tiers, DRE) n'est PAS
// intégrée ici : la faisabilité technique n'a pas été vérifiée (voir le
// "Point d'attention" du module). Ce lot trace le flux manuellement.

/// Demande de prise en charge, déclenchée à l'acceptation d'une Proposition.
/// "Chaque demande envoyée est visible avec son statut et son délai — pas de
/// demande perdue faute de suivi" (critère d'acceptation V1).
model DemandePriseEnCharge {
  id            String              @id @default(cuid())
  creeA         DateTime            @default(now())
  modifieA      DateTime            @updatedAt
  propositionId String
  proposition   Proposition         @relation(fields: [propositionId], references: [id])
  personneId    String
  statut        StatutDemandeMutuelle @default(A_ENVOYER)
  envoyeeA      DateTime?
  reponseA      DateTime?

  // Renseignés uniquement à l'accord — jamais recalculés ailleurs.
  montantPriseEnChargeTTC Int?
  motifRefus              String?

  @@index([propositionId])
  @@index([personneId])
  @@index([statut])
}

enum StatutDemandeMutuelle {
  A_ENVOYER
  ENVOYEE
  EN_ATTENTE
  ACCORD
  REFUS
}
